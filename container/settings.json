{
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(aws:*)",
      "Bash(ec2:*)",
      "Bash(jq:*)",
      "Bash(survey-status:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(mkdir:*)",
      "Read(//home/node/aws-survey/out/**)",
      "Read(//home/node/aws-survey/code/**)",
      "Edit(//home/node/aws-survey/out/**)"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(bash:*)",
      "Bash(sh:*)",
      "Bash(node:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(perl:*)",
      "Bash(xargs:*)",
      "Bash(env:*)",
      "Bash(eval:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(chmod:*)",
      "Bash(chown:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(sftp:*)",
      "Bash(session-manager-plugin:*)",
      "WebFetch",
      "WebSearch",
      "Edit(//home/node/aws-survey/out/_環境/aws-audit.log)",
      "Read(//home/node/.aws-claude/**)",
      "Read(//home/node/aws-survey/.claude/**)",
      "Edit(//home/node/aws-survey/.claude/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/aws-readonly-guard.sh"
          }
        ]
      }
    ]
  }
}
